# Personal Financial Dashboard: single container, stdlib Python server (port 8118).
#
# No pip dependencies. Settings come from .env at run time (--env-file), never baked in.
# /app/data is a mounted volume, so your numbers and daily backups survive rebuilds.
#
# Build (from this project's directory; build-run.sh does this):
#   podman build -t personal-financial-dashboard:latest -f ubuntu/Containerfile .

FROM registry.access.redhat.com/ubi9/python-311:latest
USER root
# What is deployed (shown on /healthz); build-run.sh passes them.
ARG PFD_COMMIT=unknown
ARG PFD_BUILT=unknown

WORKDIR /app
COPY server.py ./
COPY static ./static
RUN mkdir -p /app/data \
 && chown -R 1001:0 /app/data && chmod -R g+rwX /app/data

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=America/New_York \
    HOST=0.0.0.0 \
    PORT=8118 \
    DATA_DIR=/app/data \
    PFD_COMMIT=$PFD_COMMIT \
    PFD_BUILT=$PFD_BUILT

EXPOSE 8118

HEALTHCHECK --interval=30s --timeout=8s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8118/healthz')" || exit 1

USER 1001

CMD ["python", "server.py"]
