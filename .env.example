# Copy to .env (chmod 600). .env is gitignored and never committed.

# Port for ./run.sh (local). The container always uses 8118.
PFD_PORT=8118

# Container only: 127.0.0.1 = this host only (reach it over an SSH tunnel).
# 0.0.0.0 = anyone on the LAN can open it; there is no login.
PFD_BIND=127.0.0.1

# Optional: local Ollama for the plain-English advice explanation.
# Leave blank to turn it off. Use your own host; nothing is sent anywhere else.
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT=180

# Phase 2 (not used yet): E*TRADE read-only sync.
# ETRADE_CONSUMER_KEY=
# ETRADE_CONSUMER_SECRET=
# ETRADE_ENV=sandbox
