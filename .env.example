# Copy to .env (chmod 600). .env is gitignored and never committed.

# Port on this machine. The container listens on 8095 inside.
PFD_PORT=8095

# Optional: local Ollama for the plain-English advice explanation.
# Leave blank to turn it off. Use your own host; nothing is sent anywhere else.
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT=180

# Phase 2 (not used yet): E*TRADE read-only sync.
# ETRADE_CONSUMER_KEY=
# ETRADE_CONSUMER_SECRET=
# ETRADE_ENV=sandbox
